load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "provider_framework",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["host"],
    crate_name = "magicmtn_provider_framework",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.1.0",
    deps = ["//sdk/rust/magicmtn-sdk:sdk"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    crate = ":provider_framework",
)
